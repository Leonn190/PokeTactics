---
import '../styles/global.css';
const baseURL = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="app-version" content="23" />
    <meta name="theme-color" content="#0d141c" />
    <meta name="description" content="TFT Pokémon — batalha tática automática com oito participantes." />
    <title>PokéTactics V23</title>
  </head>
  <body>
    <main id="app">
      <div id="menuLayer" class="menu-layer" aria-label="Menu principal do PokéTactics">
        <div class="menu-stars" aria-hidden="true"></div>
        <section id="homeScreen" class="home-screen">
            <div class="home-topline"><span>✦ PRIMEIRA TEMPORADA</span><span>VERSÃO 23 <i></i> BETA</span></div>
          <div class="home-center">
            <div class="home-emblem" aria-label="Ícone PokéTactics"><div class="emblem-ball"><span></span></div><div class="emblem-crosshair"></div></div>
            <p class="home-eyebrow">ESTRATÉGIA · EVOLUÇÃO · CONQUISTA</p>
            <h1 class="home-logo">POKÉ<span>TACTICS</span></h1>
            <p class="home-subtitle">Seu time. Sua estratégia. Sua lenda.</p>
            <div class="home-hero-art" aria-hidden="true"><img src={`${baseURL}portrait/0003/Normal.png`} alt="" /><img src={`${baseURL}portrait/0006/Normal.png`} alt="" /><img src={`${baseURL}portrait/0009/Normal.png`} alt="" /></div>
            <div class="home-actions">
              <button id="findMatchButton" class="home-play"><span class="home-play-icon">⚔</span><span>PROCURAR PARTIDA<small>ENTRAR NA ARENA</small></span><b>›</b></button>
              <button id="sandboxMenuButton" class="home-roster"><span>🧪</span> MODO TESTE <span>›</span></button>
              <button id="openRosterButton" class="home-roster"><span>◈</span> VISUALIZAR ELENCO <span>›</span></button>
              <button id="openSettingsButton" class="home-roster"><span>⚙</span> CONFIGURAÇÕES DO JOGADOR <span>›</span></button>
              <button id="openBalanceEditorButton" class="home-roster"><span>◇</span> EDITOR DE BALANCEAMENTO <span>›</span></button>
            </div>
            <p class="home-match-note"><span class="match-status-dot"></span> MATCHMAKING DISPONÍVEL <i>•</i> 8 JOGADORES <i>•</i> 100% BOTS</p>
          </div>
          <div class="home-footer"><span>✦ MONTE. EVOLUA. DOMINE.</span><span>POKÉTACTICS © FAN GAME</span></div>
        </section>
        <section id="rosterScreen" class="roster-screen hidden" aria-label="Elenco e informações dos Pokémon">
          <header class="roster-header"><button id="rosterBack" class="roster-back">← VOLTAR</button><div><span>POKÉDEX TÁTICA</span><h2>ELENCO <em>DE POKÉMON</em></h2></div><strong id="rosterCount"></strong></header>
          <div class="roster-toolbar"><input id="rosterSearch" type="search" placeholder="⌕  Procurar Pokémon, habilidade ou tipo..." aria-label="Buscar Pokémon" /><div class="roster-filters" id="rosterFilters"><button data-filter="all" class="active">TODOS</button><button data-filter="shop">LOJA</button><button data-filter="legendary">LENDÁRIOS</button></div></div>
          <div class="roster-content"><div id="rosterGrid" class="roster-grid" aria-label="Lista de Pokémon"></div><aside id="rosterDetails" class="roster-details" aria-label="Detalhes do Pokémon"></aside></div>
        </section>
        <section id="settingsScreen" class="hidden" aria-label="Editor de configurações">
         <header class="cfg-header"><div class="cfg-header-title"><span>✦ FERRAMENTAS DE DESENVOLVIMENTO · V20</span><h2>CONFIGURAÇÕES <em>POKÉTACTICS</em></h2></div>
          <span class="cfg-count">0 ALTERAÇÕES</span><div class="cfg-header-controls">
           <button class="cfg-btn" data-cfg-changes>◈ MODIFICAÇÕES</button>
           <button class="cfg-btn warning" data-cfg-restore-section>↺ RESTAURAR SEÇÃO</button>
           <button class="cfg-btn warning" data-cfg-restore-all>⟲ RESTAURAR TUDO</button>
           <button class="cfg-btn primary" data-cfg-export>↓ BAIXAR CONFIGURAÇÕES</button>
           <button class="cfg-btn" data-cfg-back>← VOLTAR</button></div></header>
         <div class="cfg-shell"><nav class="cfg-nav" aria-label="Categorias de configuração"></nav><div class="cfg-body"></div></div>
        </section>
        <section id="queueScreen" class="queue-screen hidden" role="status" aria-live="polite"><div class="queue-ring"><div class="emblem-ball small"><span></span></div></div><span class="queue-kicker">MATCHMAKING</span><h2>ENCONTRANDO PARTIDA</h2><p>Preparando uma arena com treinadores controlados pela IA.</p><div class="queue-progress"><div id="queueFill"></div></div><div class="queue-summary"><span id="queueCount">1 / 8 TREINADORES</span><b>100% BOTS</b></div><button id="cancelQueueButton">CANCELAR BUSCA</button></section>
      </div>
      <div id="playerSettings" class="player-settings-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="playerSettingsTitle">
        <section class="player-settings-panel glass">
          <header><div><span>SUAS PREFERÊNCIAS</span><h2 id="playerSettingsTitle">CONFIGURAÇÕES DO JOGADOR</h2></div><button id="closePlayerSettings" aria-label="Fechar configurações">✕</button></header>
          <div class="player-settings-control"><div class="player-settings-label"><label for="playerVolume">VOLUME</label><output id="volumeValue" for="playerVolume">70%</output></div><input type="range" id="playerVolume" min="0" max="100" step="1" value="70" /><p>Volume dos efeitos sonoros. Em 0%, o jogo fica silencioso.</p></div>
          <div class="player-settings-control"><div class="player-settings-label"><label for="playerFps">LIMITE DE FPS</label><output id="fpsValue" for="playerFps">75 FPS</output></div><input type="range" id="playerFps" min="30" max="120" step="1" value="75" /><p>Limite de desenhos por segundo. A velocidade do combate não muda.</p></div>
          <footer>As preferências são salvas neste navegador e não afetam o balanceamento.</footer>
        </section>
      </div>
      <dialog id="settingsPassword" aria-label="Acesso às configurações"><form method="dialog"><h2>⚙ ACESSO AO CONFIGURADOR</h2><p>Área de edição e balanceamento. Informe a senha para continuar.</p><input type="password" inputmode="numeric" autocomplete="off" placeholder="Senha de acesso" required /><span class="cfg-password-error" role="alert"></span><menu><button type="button" class="cfg-btn" onclick="this.closest('dialog').close()">CANCELAR</button><button type="submit" class="cfg-btn primary">ACESSAR</button></menu></form></dialog>
      <dialog id="cfgChanges" aria-label="Parâmetros modificados"><h2>◈ MODIFICAÇÕES PENDENTES</h2><div class="cfg-changes-list"></div><form method="dialog"><button class="cfg-btn">FECHAR</button></form></dialog>
      <div id="sandboxTools" class="hidden" aria-label="Ferramentas do Modo Teste"><button id="sandboxToggle" type="button">☰ FERRAMENTAS DO TESTE</button><aside id="sandboxPanel" class="hidden" aria-label="Controles do Modo Teste"></aside></div>
      <canvas id="battlefield" aria-label="Arena hexagonal com Pokémon em combate"></canvas>
      <div class="vignette" aria-hidden="true"></div>

      <div class="top-bar">
        <div class="brand"><div class="brand-glyph" aria-hidden="true"><span></span></div><div class="brand-words"><strong>POKÉ<span>TACTICS</span></strong><small>V23 • BETA</small></div></div>
        <div class="timeline-panel glass">
          <div class="timeline-wrap"><div class="timeline-heading"><span>CAPÍTULO / ETAPA</span><b id="stageName">BATALHA</b></div><div id="chapterTrack" class="chapter-track"></div></div>
          <div class="round-clock"><div class="stage-heading"><span id="phaseLabel">PREPARAÇÃO</span><b id="roundLabel">1 — 1</b></div><div class="countdown" id="countdown">40</div><small class="seconds-label">SEG</small></div>
          <div class="stage-progress-track"><div id="stageProgress" class="stage-progress"></div></div>
        </div>
      </div>

      <aside class="traits-panel glass" aria-label="Sinergias de tipos">
        <div class="panel-heading"><span class="eyebrow">CAMPO</span><span class="panel-title">Sinergias</span></div>
        <div id="traitRows" class="trait-rows"></div>
      </aside>

      <aside id="rightPanel" class="right-panel glass" aria-label="Classificação e dados de combate">
        <div class="right-panel-tabs"><button id="tabRank" class="right-tab active" data-panel="rank">CLASSIFICAÇÃO</button><button id="tabCombat" class="right-tab" data-panel="combat">COMBATE</button></div>
        <section id="rankPanel"><div class="panel-subtitle"><span>JOGADORES</span><span>VIDA</span></div><div id="rankRows" class="rank-rows"></div></section>
        <section id="combatPanel" class="combat-panel hidden"><div class="combat-perspective"><span>RANK GERAL · ATÉ 15 POKÉMON</span><span class="combat-teams-key"><i class="ally"></i> ALIADO <i class="enemy"></i> RIVAL</span></div><div id="combatRows" class="combat-rows"></div><div class="combat-bottom-tabs"><button data-metric="status" class="metric-tab active" title="Vida restante">STATUS</button><button data-metric="damage" class="metric-tab" title="Dano físico e especial causado">DANO</button><button data-metric="mitigation" class="metric-tab" title="Mitigação por DEF (amarelo), SPD (azul) e cura (verde)">MITIGAÇÃO</button></div></section>
        <div id="scoutBadge" class="scout-badge hidden"><span id="scoutName"></span><button id="returnBoard">VOLTAR ↲</button></div>
      </aside>

      <output id="gameFpsCounter" class="game-settings-button game-fps-counter" aria-label="Taxa de quadros renderizados">FPS: —</output>
      <div class="arena-status"><span class="status-spark"></span><span id="battleStatus">PREPARAÇÃO</span></div>
      <div id="unitInspector" class="unit-inspector glass hidden"></div>

      <div id="itemInventory" class="item-inventory" aria-label="Itens apoiados no chão ao lado inferior esquerdo da arena">
        <div id="inventoryContents" class="inventory-contents"></div>
        <span id="inventoryCounter" class="sr-only" aria-live="polite">0/9</span>
      </div>
      <div id="itemDragGhost" class="item-drag-ghost hidden" aria-hidden="true"></div>
      <footer id="shopFooter" class="bottom-hud glass">
        <div class="bottom-header">
          <div class="shop-meta"><div class="shop-chances" id="shopChances" aria-label="Probabilidades por raridade"></div><div id="typeInfluence" class="type-influence" aria-label="Influência dos tipos nos sorteios da loja"></div></div>
        </div>
        <div class="shop-row">
          <div class="shop-actions">
            <div class="shop-ledger">
              <div class="gold-inline"><i>◈</i><b id="goldCount">9</b><span>OURO</span></div>
              <div class="income-tip" tabindex="0" aria-label="Detalhes da renda"><span class="economy-small">RENDA <b id="incomeCount">+5</b> ⓘ</span><div id="incomeBreakdown" class="income-breakdown" role="tooltip"></div></div>
            </div>
            <button type="button" id="buyXpButton" class="trainer-xp-buy" title="Comprar experiência para o treinador">
              <span class="trainer-xp-head"><span class="level-inline">NÍVEL <b id="levelNumber">1</b></span><span id="buyXpCost" class="xp-price">◈ 4</span></span>
              <span class="trainer-xp-action" id="buyXpAction">COMPRAR XP</span>
              <span class="trainer-xp-caption" id="trainerXpCaption">0 / 4 XP</span>
              <span class="trainer-xp-track"><i id="trainerXpFill"></i></span>
            </button>
            <button id="rerollButton" class="reroll-btn" title="Atualizar loja por 2 de ouro"><span class="reroll-icon">⟳</span><b>ROLETAR</b><small>◈ 2</small></button>
          </div>
          <div id="shopCards" class="shop-cards" aria-label="Loja de seis Pokémon"></div>
          <div id="sellOverlay" class="sell-overlay hidden">SOLTE PARA VENDER <span>◈</span></div>
        </div>
        <button id="lockButton" class="lock-btn" aria-label="Travar loja" title="Travar loja">◇</button>
      </footer>

      <div id="dragGhost" class="drag-ghost hidden"></div>
      <div id="eeveeEvolution" class="evolution-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="eeveeTitle">
        <div class="evolution-panel glass">
          <span class="evolution-kicker">QUATRO EEVEE REUNIDOS</span>
          <h2 id="eeveeTitle">Escolha sua evolução</h2>
          <p>As quatro cópias serão fundidas. A forma escolhida mantém os maiores IVs, nível e experiência.</p>
          <div id="eeveeBranches" class="evolution-choices"></div>
        </div>
      </div>
      <div id="toast" class="toast hidden" role="status" aria-live="polite"></div>
      <div id="finalBanner" class="final-banner hidden" role="status"><span id="finalKicker"></span><strong id="finalTitle"></strong><small id="finalSubtitle"></small><button id="finishedHomeButton" class="finished-home">VOLTAR AO MENU</button></div>
    </main>
    <script src="../client/main.ts"></script>
  </body>
</html>
